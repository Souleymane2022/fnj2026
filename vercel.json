{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1", "headers": { "cache-control": "public, max-age=86400" } },
    { "src": "/favicon.ico", "dest": "/assets/img/logo.svg" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
